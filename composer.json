{
	"name": "agencecinq/cinq-wp-theme-updates",
	"description": "Installs theme updates from private GitHub releases.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"i18n": [
			"wp i18n make-pot . languages/cinq-wp-theme-updates.pot --no-location --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/agencecinq/cinq-wp-theme-updates/issues\"}'",
			"wp i18n update-po languages/cinq-wp-theme-updates.pot",
			"wp i18n make-mo languages"
		]
	}
}
