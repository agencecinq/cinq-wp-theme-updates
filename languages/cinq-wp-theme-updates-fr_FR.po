#. Plugin Name of the plugin
msgid "CINQ Theme Updates"
msgstr ""

#. Plugin URI of the plugin
msgid "https://github.com/agencecinq/cinq-wp-theme-updates"
msgstr ""

#. Description of the plugin
msgid "Installs theme updates from private GitHub releases. Settings screen, no front-end markup."
msgstr "Installe les mises à jour du thème depuis des releases GitHub privées. Écran de réglages, aucun balisage côté site."

#. Author of the plugin
msgid "CINQ"
msgstr ""

#. Author URI of the plugin
msgid "https://agencecinq.com/"
msgstr ""

msgid "Repository and GitHub token are required."
msgstr "Le dépôt et le jeton GitHub sont requis."

msgid "GitHub returned an unexpected release response."
msgstr "GitHub a renvoyé une réponse inattendue pour la release."

msgid "GitHub API request failed."
msgstr "La requête à l’API GitHub a échoué."

msgid "Check that the repository exists and the token can access it."
msgstr "Vérifiez que le dépôt existe et que le jeton y a accès."

msgid "The token is invalid or expired."
msgstr "Le jeton est invalide ou a expiré."

msgid "Authorize the token for your GitHub organization SSO."
msgstr "Autorisez le jeton pour le SSO de votre organisation GitHub."

#. translators: 1: HTTP status code, 2: error message
#, php-format
msgid "GitHub API error %1$d: %2$s"
msgstr "Erreur %1$d de l’API GitHub : %2$s"

msgid "Could not create a temporary file for the theme download."
msgstr "Impossible de créer un fichier temporaire pour télécharger le thème."

#. translators: 1: HTTP status code, 2: download URL
#, php-format
msgid "Theme download failed with HTTP status %1$d (%2$s)."
msgstr "Le téléchargement du thème a échoué avec le statut HTTP %1$d (%2$s)."

msgid "Theme slug"
msgstr "Identifiant du thème"

msgid "GitHub repository"
msgstr "Dépôt GitHub"

msgid "GitHub token"
msgstr "Jeton GitHub"

msgid "Tag prefix"
msgstr "Préfixe des tags"

msgid "ZIP filename"
msgstr "Nom du fichier ZIP"

msgid "Configure GitHub release checks for private theme updates."
msgstr "Réglez la vérification des releases GitHub qui mettent à jour un thème privé."

msgid "Save settings"
msgstr "Enregistrer les réglages"

msgid "Status"
msgstr "État"

msgid "Saved in plugin settings"
msgstr "Enregistré dans les réglages de l’extension"

msgid "Missing"
msgstr "Manquant"

msgid "not configured"
msgstr "non configuré"

msgid "Monitored theme"
msgstr "Thème suivi"

msgid "Installed version"
msgstr "Version installée"

msgid "Latest GitHub release"
msgstr "Dernière release GitHub"

msgid "Unavailable."
msgstr "Indisponible."

msgid "update available"
msgstr "mise à jour disponible"

msgid "up to date"
msgstr "à jour"

#. translators: 1: active theme slug, 2: active theme version
#, php-format
msgid "Leave empty to use the active theme (%1$s, version %2$s)."
msgstr "Laissez vide pour utiliser le thème actif (%1$s, version %2$s)."

#. translators: %s: detected repository from Theme URI
#, php-format
msgid "Format: owner/repo. Auto-detected from Theme URI: %s"
msgstr "Format : owner/repo. Détecté depuis le Theme URI : %s"

msgid "not found"
msgstr "introuvable"

msgid "Fine-grained token with read access to the repository contents, or a classic token with repo scope. Leave empty to keep the saved token."
msgstr "Jeton fine-grained avec accès en lecture au contenu du dépôt, ou jeton classique avec la portée repo. Laissez vide pour garder le jeton enregistré."

msgid "Prefix stripped from tags before version comparison (default: v)."
msgstr "Préfixe retiré des tags avant de comparer les versions (par défaut : v)."

msgid "Release asset filename. Defaults to {theme-slug}.zip."
msgstr "Nom du fichier joint à la release. Par défaut : {theme-slug}.zip."

msgid "No changelog provided for this release."
msgstr "Aucun journal des modifications pour cette release."

msgid "A GitHub token is required to download theme updates."
msgstr "Un jeton GitHub est requis pour télécharger les mises à jour du thème."

msgid "no ZIP attached to the release"
msgstr "aucun ZIP joint à la release"
